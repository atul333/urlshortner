# ==============================================================================
# SocialAdLinker (https://www.socialadlinker.com) — Single AWS EC2 Configuration
# ==============================================================================

# 'development' locally, 'production' on EC2
NODE_ENV=production
PORT=3000

# Public HTTPS URL of your site (no trailing slash)
APP_URL=https://www.socialadlinker.com

# Nginx reverse proxy runs on the same EC2 server -> keep TRUST_PROXY=1
TRUST_PROXY=1

# PostgreSQL running directly on the same EC2 instance (127.0.0.1:5432)
# For local dev without Postgres installed, you can use: pglite:./data/pgdata
DATABASE_URL=postgres://socialadlinker:CHANGE_TO_STRONG_DB_PASSWORD@127.0.0.1:5432/socialadlinker
DATABASE_SSL=false
DATABASE_POOL_MAX=20

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_at_least_64_random_hex_characters_for_production_use

# Razorpay Live Credentials (Razorpay Dashboard -> Account & Settings -> API Keys & Webhooks)
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Optional SMTP for Password Reset Emails (e.g. Gmail App Password, Zoho Mail, Brevo, Resend)
# Leave blank if you don't need automated forgot-password emails yet
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SocialAdLinker <no-reply@socialadlinker.com>

# Optional one-time Admin bootstrap on first startup (only runs if no admin exists)
ADMIN_INIT_USERNAME=
ADMIN_INIT_EMAIL=
ADMIN_INIT_PASSWORD=
